#!/usr/bin/env python3
"""The Python tests a local change touches, run the way CI runs them.

    pnpm test:changed                  # select for the working tree's diff and run it
    pnpm test:changed --list           # ... print the selection, run nothing
    pnpm test:changed -- -x -k spawn   # ... pass pytest its own options after `--`

The selection is design mode's own (`refactory_dsh.test_selection.select`, the function
`design_ops.self_check_selection` calls), so a person iterating outside a run runs what the
self-check would run for the same diff: the test files the diff touched, the test files
that import a module it changed, and the engine tests when a hub changed. A change to a
file every test reads (`conftest.py`, `pytest.ini`, `pyproject.toml`, a pytest plugin,
`uv.lock`) selects the whole suite, because nothing in the import graph can say what it
reaches.

Three things the import graph cannot see are added here: a changed fixture selects the
modules that name it (or the whole suite when no text names it), a changed document selects
the tests that read documents' content, and a changed `scripts/<name>` selects
`tests/test_<name>.py`. Only `refactory/` is this command's tree: a TypeScript, `v1/` or
`scripts/` change selects no Python test of its own, and the output says when `pnpm test`
covers it.

The full suite is CI's job: it is the binding check, and a pull request's four shards run
every test once. Run it here at most once before pushing. Everything here runs on eight
workers unless `--jobs` says otherwise: a single worker takes tens of minutes.
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys
from pathlib import Path

#: The checkout this script ships in, for a directory that is not a checkout.
SHIPPED = Path(__file__).resolve().parent.parent

#: The suite CI runs; the selection is scoped to it.
SUITE = "refactory/tests"

#: Files every test reads. A change to one selects the whole suite: no import says what it
#: reaches. Plugins named by `conftest.py`'s `pytest_plugins` belong here too, and
#: `refactory/tests/test_test_changed.py` fails when one is missing.
SUITE_WIDE = frozenset({
    "conftest.py", "pytest.ini", "pyproject.toml", "setup.py", "setup.cfg", "tox.ini",
    "uv.lock", "refactory/tests/model_credential.py", "refactory/tests/repo_guard.py",
})

#: The tests that read a document's content, and the census that reads every document: a
#: changed document selects them so that a broken example is not a false green.
DOC_TESTS = (f"{SUITE}/test_ship_ready.py", f"{SUITE}/test_docs_api.py",
             f"{SUITE}/test_docs_tutorial.py", f"{SUITE}/test_docs_english_only.py")

#: Document suffixes whose content those tests read.
DOC_SUFFIXES = (".md", ".rst", ".txt", ".html")

#: Where the Python suite's own code and tests live. A change elsewhere (packages/, v1/,
#: scripts/) is not this command's to test.
PYTHON_ROOT = "refactory/"

DEFAULT_JOBS = 8


def _git(root: Path, *args: str) -> str:
    """What git prints, or "" when it fails."""
    done = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True,
                          check=False)
    return done.stdout if done.returncode == 0 else ""


def _git_checked(root: Path, *args: str) -> str:
    """What git prints; it failing where the diff depends on it is an error, never "no
    changes" (a checkout with no commits, or a base that cannot be read)."""
    done = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True,
                          check=False)
    if done.returncode != 0:
        raise SystemExit(f"test-changed: git {' '.join(args)} failed: {done.stderr.strip()}")
    return done.stdout


def _root() -> Path:
    """The checkout the diff is read from: the current directory's repository, so the
    command works from a worktree or a subdirectory, else the one this script ships in."""
    found = _git(Path.cwd(), "rev-parse", "--show-toplevel").strip()
    return Path(found) if found else SHIPPED


def _base(root: Path, requested: str) -> str:
    """The commit the diff is taken from: ``requested``, else the merge base with
    ``origin/main`` (so a branch's own commits count, not what main has since moved).

    Without ``origin/main`` there is no base that includes a branch's committed work, and
    diffing ``HEAD`` would call that work "no change": the call refuses and asks for
    ``--base`` instead of looking clean.
    """
    if requested:
        commit = _git(root, "rev-parse", "--verify", f"{requested}^{{commit}}").strip()
        if not commit:
            raise SystemExit(f"test-changed: --base {requested!r} is not a commit")
        return commit
    if not _git(root, "rev-parse", "--verify", "--quiet", "origin/main").strip():
        raise SystemExit("test-changed: no origin/main here, so work committed on a branch "
                         "would not be selected; pass --base <ref> (for example --base HEAD "
                         "for only uncommitted work)")
    return _git(root, "merge-base", "origin/main", "HEAD").strip() or "origin/main"


def _touched(root: Path, base: str) -> list[str]:
    """Every path the working tree, the index or the branch's commits change, plus the
    untracked files. Renames list both paths, so a moved source still reaches the tests
    that import its old name; NUL-separated, so a path never arrives quoted."""
    names = (_git_checked(root, "diff", "--name-only", "--no-renames", "-z", base)
             + _git_checked(root, "ls-files", "--others", "--exclude-standard", "-z"))
    return sorted({name for name in names.split("\0") if name})


def _suite_wide(names: list[str]) -> list[str]:
    return [name for name in names
            if Path(name).name in SUITE_WIDE or name in SUITE_WIDE]


def _python(root: Path) -> str:
    """The interpreter that runs pytest: the checkout's venv when there is one, else the
    one running this script."""
    venv = root / ".venv" / "bin" / "python"
    return str(venv) if venv.exists() else sys.executable


def _product(root: Path) -> str | None:
    """The checkout's own Python package, when it has one. A worktree without its own
    install must not import — or run — another checkout's product code. Keyed on the
    package directory, never on one module: a diff that deletes or renames the selector
    must be an error, not a fallback to the checkout the venv was installed from."""
    return (str(root / "refactory")
            if (root / "refactory" / "refactory_dsh" / "__init__.py").is_file() else None)


def _env(root: Path) -> dict[str, str]:
    """The child's environment, with this checkout's package first when it has one."""
    env = dict(os.environ)
    product = _product(root)
    if product:
        env["PYTHONPATH"] = product + (os.pathsep + env["PYTHONPATH"]
                                       if env.get("PYTHONPATH") else "")
    return env


def _command(python: str, jobs: int, tests: list[str], extra: list[str]) -> list[str]:
    line = [python, "-m", "pytest", "-q", "-p", "no:cacheprovider"]
    if jobs > 1:
        line += ["-n", str(jobs)]
    return [*line, *tests, *extra]


def _runnable(tests: list[str]) -> list[str]:
    """The selection pytest can run: a `.py` file or an id of one. A TypeScript spec is a
    test vitest runs, and handing it to pytest fails the whole command."""
    return [test for test in tests
            if test.split("::")[0].split(" > ")[0].strip().endswith(".py")]


def _fixture_readers(root: Path, names: list[str]) -> list[str]:
    """The modules under the suite that name a changed fixture: data files are read by
    path, so no import says which test reads one.

    Every module is scanned, not only the top-level tests: a corpus is read by a helper
    (`structure_fuzz.py` names its directory), and a fixture deep in the tree is named by
    its directory rather than its file. A path nobody names falls back to the whole suite,
    because a fixture no text names is one nothing can be cleared of.
    """
    changed = [name for name in names if name.startswith(f"{SUITE}/fixtures/")]
    if not changed:
        return []
    needles: set[str] = set()
    for name in changed:
        needles.add(Path(name).name)
        parts = Path(name).relative_to(f"{SUITE}/fixtures").parts
        if len(parts) > 1:
            needles.add(parts[0])
    modules = sorted((root / SUITE).rglob("*.py"))
    readers = [path.relative_to(root).as_posix() for path in modules
               if path.name.startswith("test_")
               and any(needle in path.read_text(errors="replace") for needle in needles)]
    return readers or [SUITE]


def _script_tests(root: Path, names: list[str]) -> list[str]:
    """`scripts/<name>`'s own test, by the repository's name-for-name convention."""
    found = []
    for name in names:
        if not name.startswith("scripts/"):
            continue
        test = root / SUITE / f"test_{Path(name).stem.replace('-', '_')}.py"
        if test.is_file():
            found.append(test.relative_to(root).as_posix())
    return found


def _doc_tests(root: Path, names: list[str]) -> list[str]:
    """A changed document selects the tests that read documents' content: their examples,
    their commands, the generated reference and tutorial, and the language census."""
    changed = any((name.endswith(DOC_SUFFIXES) or Path(name).name == "README.i18n.yaml")
                  and not name.startswith(f"{SUITE}/fixtures/") for name in names)
    return [test for test in DOC_TESTS if changed and (root / test).is_file()]


def _selection(touched: list[str], root: Path) -> list[str] | None:
    """The tests this diff reaches, or ``None`` for the whole suite."""
    if _suite_wide(touched):
        return None
    product = _product(root)
    if product and product not in sys.path:
        sys.path.insert(0, product)
    try:
        from refactory_dsh import test_selection
    except ImportError as error:
        raise SystemExit(f"test-changed: {product} has no importable "
                         f"refactory_dsh.test_selection ({error}); nothing was selected") from error
    if product:
        imported = Path(test_selection.__file__).resolve()
        if not imported.is_relative_to(Path(product).resolve()):
            raise SystemExit(f"test-changed: imported {imported}, not {product}: this "
                             "checkout's own package was not used, so its diff was not tested")

    check = f"{_python(root)} -m pytest {SUITE}"
    # Only the Python suite's own tree is this command's: a TypeScript source, a v1 module
    # or a script is not a test here (the script and document helpers below say what is).
    # A fixture is data a test reads by path: it is not a source either.
    sources = [name for name in touched
               if name.startswith(PYTHON_ROOT) and not name.startswith(f"{SUITE}/fixtures/")
               and not name.startswith("refactory/docs/")]
    selected = test_selection.select(sources, root, check_command=check,
                                     files=test_selection.repository_files(root))
    tests = _runnable(selected.tests)
    for related in (_fixture_readers(root, touched), _script_tests(root, touched),
                    _doc_tests(root, touched)):
        tests += [test for test in related if test not in tests and (root / test).exists()]
    return tests


def _reexec_target(root: Path) -> str | None:
    """The checkout's venv python, when this process is not already running in it: a system
    `python3` running this file has neither `refactory_dsh` nor pytest. The prefixes are
    compared, not the binaries: uv's venv python resolves to the same base binary as the
    one outside it."""
    venv = root / ".venv" / "bin" / "python"
    if (not venv.exists() or os.environ.get("TEST_CHANGED_IN_VENV")
            or os.path.realpath(sys.prefix) == os.path.realpath(venv.parent.parent)):
        return None
    return str(venv)


def _in_venv(root: Path) -> None:
    """Re-exec in the checkout's venv, if `_reexec_target` names it."""
    target = _reexec_target(root)
    if target:
        os.execve(target, [target, *sys.argv], {**os.environ, "TEST_CHANGED_IN_VENV": "1"})


def _note_for_packages(names: list[str]) -> str:
    return ("a change under packages/ is covered by `pnpm test`, not this command"
            if any(name.startswith("packages/") for name in names) else "")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--base", default="", help="the commit to diff against (default: the "
                                                  "merge base with origin/main; required "
                                                  "where there is no origin/main)")
    parser.add_argument("--jobs", type=int, default=DEFAULT_JOBS,
                        help=f"pytest -n workers (default {DEFAULT_JOBS}; 1 runs in-process)")
    parser.add_argument("--list", action="store_true", help="print the selection, run nothing")
    parser.add_argument("--json", action="store_true", help="print the selection as JSON too")
    parser.add_argument("--full", action="store_true", help="run the whole suite, not the selection")
    parser.add_argument("pytest_args", nargs=argparse.REMAINDER,
                        help="pytest options, after `--`")
    args = parser.parse_args(argv)
    extra = [word for word in args.pytest_args if word != "--"]

    root = _root()
    if not (root / SUITE).is_dir():
        raise SystemExit(f"test-changed: {root} has no {SUITE}")
    _in_venv(root)

    base = _base(root, args.base)
    touched = _touched(root, base)
    selected = None if args.full else _selection(touched, root)
    if selected is None:
        tests, why = [SUITE], "the whole suite: the change touches a file every test reads"
    else:
        tests, why = selected, f"{len(selected)} test file(s)"
    command = _command(_python(root), max(1, args.jobs), tests, extra)
    packages = _note_for_packages(touched)

    if args.list or args.json:
        record = {"base": base, "touched": touched, "selection": tests,
                  "suite_wide": selected is None,
                  "not_selected": sorted(set(touched) - set(tests))}
        if args.json:
            record["command"] = shlex.join(command)
            print(json.dumps(record, indent=1))
        elif tests:
            print("\n".join(tests))
        else:
            print("test-changed: nothing selected", file=sys.stderr)
        return 0

    if not tests:
        print(f"test-changed: nothing selected: {len(touched)} changed file(s) reach no test "
              f"in {SUITE}.{' (' + packages + ')' if packages else ''}")
        return 0
    print(f"test-changed: {len(touched)} changed file(s) select {why} from {base[:12]}")
    if packages:
        print(f"test-changed: {packages}")
    print("running: " + shlex.join(command), flush=True)
    return subprocess.run(command, cwd=str(root), env=_env(root), check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))

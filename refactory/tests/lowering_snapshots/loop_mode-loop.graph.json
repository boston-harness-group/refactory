    },
    "init": {
      "id": "init",
      "reads": [],
      "writes": [
        "loop/config.json",
        "loop/journal.jsonl",
        "loop/state.json"
      ],
      "blocking": true,
      "command": "python -m refactory_dsh.run refactory_packages.loop_mode.ops:init",

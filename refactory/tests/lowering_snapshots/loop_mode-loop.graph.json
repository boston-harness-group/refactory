        "loop/report.md"
      ],
      "blocking": true,
      "command": "python -m refactory_dsh.run refactory_packages.loop_mode.ops:report",
      "callable_name": "refactory_packages.loop_mode.ops:report",
      "notes": "write the report, the visibility surface",
      "_type": "FnNode"
    },
    "scheduler": {
      "id": "scheduler",
      "reads": [
        "loop/journal.jsonl"
      ],
      "writes": [
        "loop/journal.jsonl",
        "loop/state.json",

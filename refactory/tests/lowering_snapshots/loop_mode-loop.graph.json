    },
    "step": {
      "id": "step",
      "reads": [
        "loop/journal.jsonl",
        "loop/pending.json"
      ],
      "writes": [
        "loop/journal.jsonl",
        "loop/state.json"
      ],
      "blocking": true,
      "command": "python -m refactory_dsh.run refactory_packages.loop_mode.ops:step",
      "callable_name": "refactory_packages.loop_mode.ops:step",
      "notes": "install the offspring that are genuinely new points",
      "_type": "FnNode"
